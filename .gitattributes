# Auto detect text files and perform LF normalization
* text=auto

# data/ holds trimmed ROOT inputs, tracked directly (see scripts/slim_data_files.py).
# The LFS filters that used to live here are gone on purpose: after trimming, the
# largest file is 48 MB, so nothing needs LFS and `git add data/` must not route
# through it. Mark them binary so autocrlf can never touch them.
*.root binary
